{
  "name": "production-suite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web,tablet,scan -c blue,green,magenta,cyan \"npm run dev:server\" \"npm run dev:client:delayed\" \"npm run dev:tablet-legacy:delayed\" \"npm run dev:legacy:delayed\"",
    "dev:wait-api": "wait-on -t 120000 http-get://127.0.0.1:3001/",
    "dev:client:delayed": "npm run dev:wait-api && npm run dev:client",
    "dev:tablet-legacy:delayed": "npm run dev:wait-api && npm run dev:tablet-legacy",
    "dev:legacy:delayed": "npm run dev:wait-api && npm run dev:legacy",
    "dev:phone": "concurrently -k \"npm run dev\" \"sleep 5 && cloudflared tunnel --url http://127.0.0.1:5173\"",
    "tunnel": "cloudflared tunnel --url http://127.0.0.1:5173",
    "dev:client": "vite",
    "dev:legacy": "vite --config legacy/operation/vite.config.ts",
    "dev:tablet-legacy": "vite --config legacy/vite.config.ts",
    "dev:tablet": "concurrently -n api,tablet -c blue,magenta \"npm run dev:server\" \"npm run dev:tablet-legacy:delayed\"",
    "dev:tablet:ui-only": "npm run dev:tablet-legacy",
    "check:tablet-api": "tsx scripts/check-tablet-api.ts",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "tsx scripts/prisma-with-env.ts migrate dev",
    "prisma:push": "tsx scripts/prisma-with-env.ts db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:clean": "tsx scripts/clean-scheduler-db.ts",
    "db:clean:seed": "tsx scripts/clean-scheduler-db.ts --seed",
    "db:dedupe-machines": "tsx scripts/dedupe-scheduler-machines.ts",
    "import:labex": "tsx scripts/import-labex-submissions.ts",
    "db:backfill-job-material": "tsx scripts/migrate-job-material-filename.ts",
    "db:backfill-job-schedules": "tsx scripts/backfill-job-machine-schedules.ts",
    "check-schema": "tsx server/db/check-schema.ts",
    "migrate-scheduler-db": "tsx scripts/migrate-scheduler-to-db.ts",
    "migrate-jobmanager-tables": "tsx scripts/migrate-jobmanager-tables-to-app.ts",
    "test-connection": "tsx server/db/test-connection.ts",
    "test-printbeat": "tsx scripts/test-printbeat-parse.ts",
    "test-bladerunner": "tsx scripts/test-bladerunner-live.ts",
    "db:catch-up-markers": "tsx scripts/catch-up-processing-markers.ts",
    "list-jobmanager-materials": "tsx scripts/list-jobmanager-material-tables.ts",
    "import:material-list": "tsx scripts/import-material-list-csv.ts",
    "print-os": "tsx scripts/print-os-maintenance.ts",
    "db:backfill-op004": "tsx scripts/backfill-op004-completion.ts",
    "run-migrations": "tsx server/db/run-migrations.ts",
    "test:e2e": "playwright test",
    "test:e2e:ci": "npm run prisma:push && playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^5.22.0",
    "@zxing/browser": "^0.1.5",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "lucide-react": "^0.561.0",
    "pg": "^8.11.3",
    "prisma": "^5.22.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.54.2",
    "recharts": "^3.8.1",
    "sharp": "^0.35.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^8.2.2",
    "tsx": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "^8.1.5",
    "wait-on": "^9.0.10"
  }
}
